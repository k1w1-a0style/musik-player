# EAS uses this file instead of .gitignore. Keep local secrets out of the source archive.
.git
node_modules/
/android/
/ios/
.expo/
.expo-shared/
.cache/
dist/
build/
web-build/
coverage/
.nyc_output/
ci-logs/
ci-android-export/
__pycache__/
*.pyc
expo-config.json

# Environment and signing inputs are handled by EAS credentials, never source upload.
.env
.env.*
*.env
!.env.example
credentials.json
ci-credentials/
.credentials/
*.p12
*.jks
*.keystore
*.pem
*.key
**/.npmrc

# Local diagnostics, archives and backups.
*.log
*.bak
*.backup
*.orig
*.tmp
*~
k1w1-*.zip
*_patch*.zip
project_src_*.zip
project_dump_*.zip
.emergent/
preview.html
.gitconfig
.DS_Store
Thumbs.db
.vscode/
.idea/
