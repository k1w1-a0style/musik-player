    "@xmldom/xmldom@>=0.7.0 <0.9.0": "0.8.15",
    "@xmldom/xmldom@>=0.9.0 <0.10.0": "0.9.12",
    "compression": "1.8.2",
    "source-map-js": "1.2.2"
