{
  "name": "musik-player",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "check:android-permissions": "node scripts/ci/checkGeneratedAndroidManifestPermissions.cjs",
    "check:source-nul": "node scripts/ci/checkSourceNulBytes.cjs",
