{
  "name": "musik-player",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "check:android-permissions": "node scripts/ci/checkGeneratedAndroidManifestPermissions.cjs",
    "check:source-nul": "node scripts/ci/checkSourceNulBytes.cjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:silent": "jest --runInBand",
    "postinstall": "node scripts/patches/patchReactNativeTrackPlayer.cjs",
    "inspect:android-apk": "node scripts/ci/inspectAndroidApk.cjs",
    "check:complexity": "node scripts/ci/checkCodeComplexity.cjs",
    "check:expo-deps": "expo install --check"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.14.11",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-system-audio": "file:./modules/expo-system-audio",
    "image-size": "1.2.1",
    "lucide-react-native": "1.8.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-track-player": "4.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "babel-preset-expo": "54.0.12",
    "eslint": "10.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.5.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.59.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player"
        ]
      }
    }
  },
  "overrides": {
    "postcss": "8.5.23",
    "ws": "^8.21.1",
    "@tootallnate/once": "^3.0.1",
    "brace-expansion@>=1.0.0 <2.0.0": "1.1.18",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.9",
    "fast-uri@^3.0.0": "3.1.5",
    "form-data@^4.0.0": "4.0.6",
    "js-yaml@>=3.0.0 <4.0.0": "3.15.1",
    "js-yaml@>=4.0.0 <5.0.0": "4.3.1",
    "tar@^7.0.0": "7.5.22",
    "undici@^6.0.0": "6.28.0",
    "xcode": {
      "uuid": "11.1.1"
    },
    "shell-quote": "1.10.0",
    "nanoid@>=3.0.0 <4.0.0": "3.3.18"
  }
