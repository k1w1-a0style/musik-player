    "test:coverage": "jest --coverage",
    "test:silent": "jest --runInBand",
    "postinstall": "node scripts/patches/patchRntpV5.cjs",
    "inspect:android-apk": "node scripts/ci/inspectAndroidApk.cjs",
    "check:complexity": "node scripts/ci/checkCodeComplexity.cjs",
    "check:expo-deps": "expo install --check"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.14.11",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-system-audio": "file:./modules/expo-system-audio",
    "lucide-react-native": "1.8.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-track-player": "file:./modules/playback-backend",
    "zod": "4.3.6",
    "@rntp/player": "5.12.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "babel-preset-expo": "~57.0.14",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "@react-native/jest-preset": "0.86.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player"
        ]
      }
