        {
          "path": "lib/assert-depth.js",
          "upstreamSha256": null,
          "patchedSha256": "977af7e67e0ef1732d4f137fbeb888ff8b1e1f2c2cf22a593ef8f07803ff05ac",
          "edits": [
            {
              "from": null,
              "to": "'use strict';\n// PR #88 parser/traversal bound, with bounded visits and parent-chain checks.\nconst MAX_DEPTH = 128;\nconst MAX_VISITS = 65536;\n\nfunction assertParentChain(node) {\n  const seen = new WeakSet();\n  let depth = 0;\n  for (let parent = node; parent && parent.type !== 'root' && parent.type !== 'brace'; parent = parent.parent) {\n    if (typeof parent !== 'object' || seen.has(parent) || ++depth > MAX_DEPTH) {\n      throw new SyntaxError('Brace AST has an unsafe parent chain');\n    }\n    seen.add(parent);\n  }\n}\n\nmodule.exports = ast => {\n  const pending = [[ast, 0, false]];\n  const active = new WeakSet();\n  let visits = 0;\n  while (pending.length) {\n    const [node, depth, exit] = pending.pop();\n    if (exit) { active.delete(node); continue; }\n    if (!node || typeof node !== 'object' || depth > MAX_DEPTH || ++visits > MAX_VISITS) {\n      throw new SyntaxError('Brace AST exceeds safe traversal limits');\n    }\n    if (active.has(node)) throw new SyntaxError('Brace AST must be acyclic');\n    assertParentChain(node);\n    active.add(node);\n    pending.push([node, depth, true]);\n    if (node.nodes !== undefined) {\n      if (!Array.isArray(node.nodes) || node.nodes.length > MAX_VISITS - visits) {\n        throw new SyntaxError('Brace AST children exceed safe traversal limits');\n      }\n      for (const child of node.nodes) pending.push([child, depth + 1, false]);\n    }\n  }\n};\n"
            }
          ]
        }
