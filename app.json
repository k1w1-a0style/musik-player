{
  "expo": {
    "name": "Musikplayer",
    "slug": "musikplayer",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "android": {
      "package": "com.example.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F5B301"
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
